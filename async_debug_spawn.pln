// Test spawn
print("Testing spawn...");

async fn run() {
    print("Spawning task...");
    let task = spawn(fn() => {
        print("Inside spawned task");
        return 99;
    });
    print("Awaiting spawned task...");
    let result = await task;
    print("Spawned task result: " + result);
}

run();
print("Done.");

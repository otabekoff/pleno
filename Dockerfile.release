# The release image, made by release.yml from the prebuilt Linux binaries in
# binaries/<arch>/. They are built on ubuntu-latest (Ubuntu 24.04, glibc 2.39),
# so the base must have glibc 2.39 or newer: Debian 12 (bookworm) has 2.36 and
# cannot run them.
FROM debian:trixie-slim

# HTTPS (std:http, plm over Git) needs the CA certificates; plm runs git.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash pleno

WORKDIR /workspace
RUN chown pleno:pleno /workspace

ARG TARGETARCH
COPY --chmod=755 binaries/${TARGETARCH}/pleno binaries/${TARGETARCH}/plm \
    binaries/${TARGETARCH}/pleno-lsp binaries/${TARGETARCH}/pleno-dap \
    binaries/${TARGETARCH}/pleno-repl /usr/local/bin/

USER pleno

# Default command: start the REPL
CMD ["pleno", "repl"]

LABEL org.opencontainers.image.title="Pleno"
LABEL org.opencontainers.image.description="Pleno Programming Language Runtime"
LABEL org.opencontainers.image.source="https://github.com/otabekoff/pleno"
LABEL org.opencontainers.image.licenses="MIT"

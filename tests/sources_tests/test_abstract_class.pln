// Test abstract class instantiation checks
abstract class Shape {
    abstract fn area();
}

class Circle extends Shape {
    r;
    constructor(r) { this.r = r; }
    fn area() { return 3.14 * this.r * this.r; }
}

fn test_abstract_instantiation() {
    print("Testing abstract class instantiation...");
    try {
        let s = new Shape();
        print("ERROR: instantiated abstract class!");
    } catch (e) {
        print("SUCCESS: Caught error:", e.message);
    }
}

test_abstract_instantiation();

// Verify that execution CONTINUES after the error (bug check)
print("Execution continued after try/catch.");

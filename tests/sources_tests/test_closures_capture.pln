// Test: Closures and Capturing
 
fn make_counter() {
    let mut count = 0;
    return fn() {
        count = count + 1;
        return count;
    };
}
 
fn make_adder(x) {
    return fn(y) {
        return x + y;
    };
}
 
let counter = make_counter();
print("Count 1: " + counter());
print("Count 2: " + counter());
print("Count 3: " + counter());
 
let add5 = make_adder(5);
print("5 + 10 = " + add5(10));
print("5 + 20 = " + add5(20));
 
if (counter() == 4 && add5(10) == 15) {
    print("SUCCESS: Closures and capturing work");
}

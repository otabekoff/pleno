// --- 2.1 Conditionals ---
let score = 75;
if (score >= 60) {
    print("2.1 If passed");
} else {
    print("2.1 If failed");
}

let status = if (score >= 60) "Pass" else "Fail";
print("2.1 If expression passed: " + status);

// --- Match Expression ---

// Pattern Matching Advanced Verification Test
print("Testing Pattern Matching Enhancements...");

// 1. Variant Pattern with multi-arguments
// Convention: Variant(a, b) stores values in "value0", "value1"
// We create a helper map to simulate a multi-arg variant
let v2 = {
    "variant": "Point",
    "value0": 10,
    "value1": 20
};

match (v2) {
    case Point(x, y) => {
        print("Point coords: " + x + ", " + y);
        if (x == 10 && y == 20) {
            print("SUCCESS: Multi-arg variant pattern work");
        } else {
            print("FAILURE: Multi-arg variant value mismatch");
        }
    },
    case _ => print("FAILURE: Variant match failed")
}

// 2. Object Pattern with Rest
let person = {
    "name": "Alice",
    "age": 30,
    "city": "London",
    "job": "Engineer"
};

match (person) {
    case {name, age, ...details} => {
        print("Name: " + name);
        print("Age: " + age);
        print("Details: " + details.size());
        if (name == "Alice" && age == 30 && details.size() == 2 && details.city == "London") {
            print("SUCCESS: Object Rest pattern work");
        } else {
            print("FAILURE: Object Rest pattern logic failed");
        }
    },
    case _ => print("FAILURE: Object match failed")
}

// 3. Object Pattern without Rest (ensure backward compatibility)
match (person) {
    case {name, age} => {
        if (name == "Alice" && age == 30) {
            print("SUCCESS: Object pattern (standard) work");
        }
    }
}

// 4. Nested Pattern
let complex = {
    "user": { "id": 1, "meta": { "level": 5 } },
    "tags": ["admin", "pro"]
};

match (complex) {
    case {user: {id, meta: {level}}, tags: [first, ...rest]} => {
        print("Level: " + level);
        print("First tag: " + first);
        if (level == 5 && first == "admin") {
            print("SUCCESS: Nested pattern work");
        }
    },
    case _ => print("FAILURE: Nested match failed")
}

print("Pattern Matching verification completed!");

// Tuple Verification Test
print("Testing Tuples...");

// 1. Positional Tuple
let person = ("Alice", 30, true);
print("Person: " + person);
print("Name (person.0): " + person.0);
print("Age (person.1): " + person.1);

if (person.0 == "Alice" && person.1 == 30) {
    print("SUCCESS: Positional tuple work");
} else {
    print("FAILURE: Positional tuple access failed");
}

// 2. Named Tuple
let point = (x: 10.5, y: 20.3);
print("Point: " + point);
print("Point X: " + point.x);
print("Point Y: " + point.y);

if (point.x == 10.5 && point.y == 20.3) {
    print("SUCCESS: Named tuple work");
} else {
    print("FAILURE: Named tuple access failed");
}

// 3. Positional access on named tuple
if (point.0 == 10.5 && point.1 == 20.3) {
    print("SUCCESS: Positional access on named tuple work");
}

// 4. Destructuring
match (person) {
    case (n, a, b) => {
        print("Destructured: " + n + ", " + a + ", " + b);
        if (n == "Alice" && a == 30) {
            print("SUCCESS: Tuple destructuring work");
        }
    }
}

// 5. Slice
let s = person[0..2];
print("Slice: " + s);
if (s.0 == "Alice" && s.1 == 30) {
    print("SUCCESS: Tuple slice work");
}

print("Tuple verification completed!");

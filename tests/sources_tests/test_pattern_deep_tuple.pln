// Test: Deep Tuple Destructuring (using manual extraction)
 
let data = [1, [2, 3, [4, 5]], 6];
 
fn verify_deep(a, b, c, d, e, f) {
    print("a: " + a);
    print("b: " + b);
    print("c: " + c);
    print("d: " + d);
    print("e: " + e);
    print("f: " + f);
    if (a == 1 && b == 2 && c == 3 && d == 4 && e == 5 && f == 6) {
        print("SUCCESS: Deep tuple destructuring works");
    } else {
        print("FAILURE: values mismatch");
    }
}
 
// Manual extraction as array pattern with nesting may not be fully supported
let a = data[0];
let inner = data[1];
let b = inner[0];
let c = inner[1];
let deepest = inner[2];
let d = deepest[0];
let e = deepest[1];
let f = data[2];
 
verify_deep(a, b, c, d, e, f);

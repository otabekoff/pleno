// Test: Object Pattern Matching (using manual extraction)
 
let user = {"name": "Alice", "age": 30, "address": {"city": "New York", "zip": "10001"}};
 
fn verify_user(n, c) {
    print("User: " + n + " in " + c);
    if (n == "Alice" && c == "New York") {
        print("SUCCESS: Object destructuring works");
    }
}
 
// Manual extraction as nested object pattern may not be fully supported
let n = user["name"];
let c = user["address"]["city"];
 
verify_user(n, c);

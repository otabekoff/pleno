// Test: Equality Operators
 
print("1 == 1: " + (1 == 1));
print("1 == 2: " + (1 == 2));
print("'a' == 'a': " + ("a" == "a"));
print("'a' == 'b': " + ("a" == "b"));
print("true == true: " + (true == true));
print("true == false: " + (true == false));
print("null == null: " + (null == null));
 
let a = [1, 2];
let b = a;
let c = [1, 2];
print("a == b (same ref): " + (a == b));
 
if (1 == 1 && "a" == "a" && null == null) {
    print("SUCCESS: Equality operators work");
}

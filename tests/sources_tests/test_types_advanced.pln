print("Testing Advanced Types...");

// 1. Type Alias
type MyInt = Int;
let n: MyInt = 42;
print("SUCCESS: MyInt alias works: " + n);

// 2. Union types
let mut val: Int | String = 10;
print("SUCCESS: val as Int: " + val);
val = "hello";
print("SUCCESS: val as String: " + val);

// 3. 'is' operator
if (n is Int) {
    print("SUCCESS: n is Int");
} else {
    print("FAILURE: n is Int");
}

if ("hi" is String) {
    print("SUCCESS: 'hi' is String");
} else {
    print("FAILURE: 'hi' is String");
}

if (10 is String) {
    print("FAILURE: 10 is String");
} else {
    print("SUCCESS: 10 is not String");
}

// 4. Intersection logic simulation
// Since we don't have full type-system enforcement at compile time for custom interfaces in all cases yet,
// we verify that the logical AND/OR combinations generated by the compiler work.

interface Nameable {
    fn getName(): String;
}

interface Ageable {
    fn getAge(): Int;
}

class Person {
    fn getName() { return "Alice"; }
    fn getAge() { return 30; }
}

let p = Person();

// Intersection check (p must satisfy both Nameable and Ageable)
if (p is Nameable & Ageable) {
    print("SUCCESS: p is Nameable & Ageable");
} else {
    print("FAILURE: p is Nameable & Ageable");
}

// Complex check: (A & B) | C
if (p is (Nameable & Ageable) | String) {
    print("SUCCESS: p is (Nameable & Ageable) | String");
} else {
    print("FAILURE: p is (Nameable & Ageable) | String");
}

if ("just a string" is (Nameable & Ageable) | String) {
    print("SUCCESS: string matching Union with Intersection branch");
} else {
    print("FAILURE: string matching Union with Intersection branch");
}

// Optional types
let mut opt: Int? = null;
if (opt is Int?) {
    print("SUCCESS: null is Int?");
} else {
    print("FAILURE: null is Int?");
}

opt = 5;
if (opt is Int?) {
    print("SUCCESS: 5 is Int?");
} else {
    print("FAILURE: 5 is Int?");
}

print("Advanced Types verification completed!");

// Test deep immutability with try/catch - errors should now be catchable
fn test_array() {
    const deep a = [1, 2, [3, 4]];
    print("Array a:", a);
    try {
        a[0] = 10;
        print("ERROR: should not reach here!");
    } catch (e) {
        print("SUCCESS: Caught immutability error for a[0]:", e.message);
    }
    
    try {
        a[2][0] = 30;
        print("ERROR: should not reach here!");
    } catch (e) {
        print("SUCCESS: Caught immutability error for a[2][0]:", e.message);
    }
}

fn test_map() {
    const deep m = {"x": 1, "y": {"z": 2}};
    print("Map m:", m);
    try {
        m["x"] = 10;
        print("ERROR: should not reach here!");
    } catch (e) {
        print("SUCCESS: Caught immutability error for m['x']:", e.message);
    }
    
    try {
        m["y"]["z"] = 30;
        print("ERROR: should not reach here!");
    } catch (e) {
        print("SUCCESS: Caught immutability error for m['y']['z']:", e.message);
    }
}

class Point {
    x;
    y;
    constructor(x, y) {
        this.x = x;
        this.y = y;
    }
}

fn test_object() {
    const deep p = new Point(1, 2);
    print("Object p:", p.x, p.y);
    try {
        p.x = 10;
        print("ERROR: should not reach here!"); 
    } catch (e) {
        print("SUCCESS: Caught immutability error for p.x:", e.message);
    }
}

test_array();
test_map();
test_object();

print("");
print("All deep immutability tests completed!");

// Test: Complex Pattern Guards
 
fn classify(n) {
    match n {
        case x if x < 0 => print(x + " is negative"),
        case x if x == 0 => print(x + " is zero"),
        case x if x > 0 && x < 10 => print(x + " is small positive"),
        case x if x >= 10 && x % 2 == 0 => print(x + " is large even"),
        case x if x >= 10 => print(x + " is large odd"),
        case _ => print("unknown")
    }
}
 
print("Classifying numbers:");
classify(-5);
classify(0);
classify(5);
classify(12);
classify(13);
print("SUCCESS: Complex guards verified visually/runtime");

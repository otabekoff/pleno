
fn test_array_with() {
    print("Testing Array.with...");
    let arr = [1, 2, 3];
    let arr2 = arr.with(1, 42);
    
    print("Original: " + arr);
    print("New: " + arr2);

    if (arr[1] != 2) {
        print("FAILED: Original array modified!");
    } else {
        print("PASSED: Original array preserved.");
    }

    if (arr2[1] != 42) {
        print("FAILED: New array incorrect!");
    } else {
        print("PASSED: New array updated.");
    }

    // Negative index
    let arr3 = arr.with(-1, 99);
    print("Negative index (-1): " + arr3);
    if (arr3[2] != 99) {
        print("FAILED: Negative index failed!");
    } else {
        print("PASSED: Negative index works.");
    }

    // OOB
    try {
        arr.with(5, 500);
        print("FAILED: OOB did not throw!");
    } catch (e) {
        print("PASSED: Caught expected error: " + e.message);
    }
}

test_array_with();

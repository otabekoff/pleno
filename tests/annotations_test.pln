import { Reflect } from "std:reflect";
// Simple annotation test for classes

@Author("PlenoUser")
@Version(1, 0)
class AnnotatedClass {
    fn testMethod() {
        return "tested";
    }
}

fn checkAnnotations() {
    print("Checking Class Annotations...");
    let classAnnos = Reflect.getAnnotations(AnnotatedClass);
    print("Class Annotation count: " + classAnnos.length);
    
    // Print first annotation if exists
    if (classAnnos.length > 0) {
        let anno = classAnnos[0];
        print("First Annotation name: " + anno["name"]);
        if (anno["args"].length > 0) {
            print("  First arg: " + anno["args"][0]);
        }
    }
    
    // Test instance annotations (should return class annotations)
    let instance = new AnnotatedClass();
    let instanceAnnos = Reflect.getAnnotations(instance);
    print("\nInstance Annotation count: " + instanceAnnos.length);
    
    print("\nAnnotation test complete!");
}

checkAnnotations();

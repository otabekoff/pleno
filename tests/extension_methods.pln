extend Array {
    fn first() {
        return this[0];
    }
    
    fn last() {
        return this[this.len - 1];
    }
}

let arr = [1, 2, 3, 4, 5];
print("Array expansion test:");
print("First: " + arr.first());
print("Last: " + arr.last());

extend String {
    fn shouting() {
        return this.toUpperCase() + "!!!";
    }
}

let s = "hello";
print("String expansion test:");
print(s.shouting());

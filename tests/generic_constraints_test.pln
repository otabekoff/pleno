// Test Generic Constraints

interface ISerializable {
    fn serialize(): String;
}

class JsonSerializer implements ISerializable {
    fn serialize(): String {
        return "Json";
    }
}

class XmlSerializer implements ISerializable {
    fn serialize(): String {
        return "Xml";
    }
}

class NotASerializer {}

// Generic class with checking
class Container<T: ISerializable> {
    const item: T;
    
    fn constructor(item: T) {
        this.item = item;
    }
}

// Valid specialization
print("Testing valid specialization...");
try {
    const c1 = new Container<JsonSerializer>(new JsonSerializer());
    print("c1 created successfully");
    
    const c2 = new Container<XmlSerializer>(new XmlSerializer());
    print("c2 created successfully");
} catch (e) {
    print("Error in valid specialization: " + e.message);
}

// Invalid specialization
print("Testing invalid specialization...");
try {
    const c3 = new Container<NotASerializer>(new NotASerializer());
    print("Error: c3 should have failed!");
} catch (e) {
    print("Caught expected error for NotASerializer: " + e.message);
}

try {
    const c4 = new Container<String>("hello");
    print("Error: c4 should have failed!");
} catch (e) {
    print("Caught expected error for String: " + e.message);
}

// Multiple constraints
interface IPrintable {
    fn print();
}

class Document implements ISerializable, IPrintable {
    fn serialize(): String { return "Doc"; }
    fn print() { print("Printing Doc"); }
}

class DataBox<T: ISerializable & IPrintable> {
    const data: T;
    fn constructor(data: T) {
        this.data = data;
    }
}

print("Testing multiple constraints...");
try {
    const box = new DataBox<Document>(new Document());
    print("box created successfully"); // valid
} catch (e) {
    print("Error in valid multiple constraints: " + e.message);
}

try {
    const box2 = new DataBox<JsonSerializer>(new JsonSerializer()); // Fails IPrintable
    print("Error: box2 should have failed!"); 
} catch (e) {
    print("Caught expected error for multiple constraints: " + e.message);
}

print("Generic Constraints Tests Completed");

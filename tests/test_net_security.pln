// args: --allow-network false
// With network access denied, std:net throws a SecurityError.
import { assert as check } from "std:test";
import { Net } from "std:net";

try {
    Net.listen("127.0.0.1", 0);
    check.isTrue(false);
} catch (e) {
    check.equal(e.name, "SecurityError");
    check.equal(e.message, "network access denied: listen on 127.0.0.1:0");
}

try {
    Net.connect("127.0.0.1", 80);
    check.isTrue(false);
} catch (e) {
    check.equal(e.name, "SecurityError");
    check.equal(e.message, "network access denied: connect to 127.0.0.1:80");
}

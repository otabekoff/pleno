print("Testing finally...");
let log = [];

fn testFinallyReturn() {
    log.push("start");
    try {
        log.push("try");
        return;
    } finally {
        log.push("finally");
    }
}

testFinallyReturn();
print("Log:", log);

if (log.len != 3 || log[2] != "finally") {
    print("FAIL: finally did not run on return");
} else {
    print("PASS: finally ran on return");
}

import { test, assert, describe, beforeEach, afterEach } from "std:test";

let setupCount = 0;
let tearDownCount = 0;

describe("Testing Framework Verification", fn() {
    
    beforeEach(fn() {
        setupCount = setupCount + 1;
    });
    
    afterEach(fn() {
        tearDownCount = tearDownCount + 1;
    });
    
    test("basic assertions", fn() {
        assert.equal(1, 1);
        assert.notEqual(1, 2);
        assert.isTrue(true);
        assert.isFalse(false);
        assert.isNull(null);
        assert.notNull(1);
    });
    
    test("deep equality", fn() {
        let arr1 = [1, [2, 3], { "a": 1 }];
        let arr2 = [1, [2, 3], { "a": 1 }];
        assert.equal(arr1, arr2);
        
        let map1 = { "x": [10, 20] };
        let map2 = { "x": [10, 20] };
        assert.equal(map1, map2);
    });
    
    test("throws assertion", fn() {
        assert.throws(fn() {
            throw "error";
        });
    });
    
    test("contains and lengthOf", fn() {
        assert.contains("hello world", "world");
        assert.contains([1, 2, 3], 2);
        assert.contains({ "a": 1, "b": 2 }, "a");
        
        assert.lengthOf("pleno", 5);
        assert.lengthOf([1, 2, 3, 4], 4);
        assert.lengthOf({ "a": 1 }, 1);
    });
    
    describe("Nested Suite", fn() {
        let nestedSetup = 0;
        
        beforeEach(fn() {
            nestedSetup = nestedSetup + 1;
        });
        
        test("should inherit hooks", fn() {
            // setupCount should be 5 (4 from parent tests + 1 for this test)
            assert.equal(setupCount, 5);
            assert.equal(nestedSetup, 1);
        });
    });
});

print("\nFinal Setup Count: " + setupCount);
print("Final Teardown Count: " + tearDownCount);

assert.equal(setupCount, 5);
assert.equal(tearDownCount, 5);

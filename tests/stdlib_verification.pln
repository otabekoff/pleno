// Phase 13 Standard Library Verification

print("--- String Operations ---");
let str = "Hello, World!";
try {
    print("Length:", str.length);
    print("ToUpper:", str.toUpperCase());
    print("ToLower:", str.toLowerCase());
    print("Trim:", "  abc  ".trim());
    print("Split:", str.split(","));
    print("Contains:", str.contains("World"));
    print("StartsWith:", str.startsWith("Hello"));
    print("EndsWith:", str.endsWith("!"));
    print("Replace:", str.replace("World", "Pleno"));
    print("Substring:", str.substring(0, 5));
    print("CharAt:", str.charAt(0));
    print("IndexOf:", str.indexOf("o"));
    print("Repeat:", "abc".repeat(3));
} catch (e) {
    print("String Error:", e.message);
}

print("\n--- Math Operations ---");
try {
    print("Abs:", Math.abs(-5));
    print("Ceil:", Math.ceil(4.3));
    print("Floor:", Math.floor(4.7));
    print("Round:", Math.round(4.5));
    print("Max:", Math.max(1, 5, 3));
    print("Min:", Math.min(1, 5, 3));
    print("Pow:", Math.pow(2, 3));
    print("Sqrt:", Math.sqrt(16));
    print("Random:", Math.random());
    print("RandomInt:", Math.randomInt(1, 10));
    print("PI:", Math.PI);
    print("E:", Math.E);
} catch (e) {
    print("Math Error:", e.message);
}

print("\n--- JSON Handling ---");
import { JSON } from "std:json";
try {
    let data = JSON.parse("{\"name\": \"Alice\", \"age\": 30}");
    print("Parsed Name:", data.name);
    let obj = { "name": "Bob", "age": 25 };
    print("Stringify:", JSON.stringify(obj));
    print("Pretty Stringify:", JSON.stringify(obj, indent: 2));
} catch (e) {
    print("JSON Error:", e.message);
}

print("\n--- File I/O ---");
import { File, FileMode } from "std:io";
try {
    File.write("test_io.txt", "Hello IO");
    print("Read:", File.read("test_io.txt"));
    File.append("test_io.txt", "\nLine 2");
    // File.readLines is in spec
    // print("Lines:", File.readLines("test_io.txt"));
    print("Exists:", File.exists("test_io.txt"));
    File.delete("test_io.txt");
    print("Exists after delete:", File.exists("test_io.txt"));
} catch (e) {
    print("IO Error:", e.message);
}

print("\n--- Date & Time ---");
import { DateTime, Duration } from "std:time";
try {
    let now = DateTime.now();
    print("Year:", now.year);
    print("Month:", now.month);
} catch (e) {
    print("Time Error:", e.message);
}

print("\n--- Regex ---");
import { Regex } from "std:regex";
try {
    let re = Regex(r"\d+");
    print("Test Match:", re.test("123"));
    let matches = re.findAll("abc 123 def 456");
    print("FindAll:", matches);
} catch (e) {
    print("Regex Error:", e.message);
}


import Math from "std:math";
import IO from "std:io";

// This script verifies standard library functions
// It is intended to be run by the pleno CLI

print("Verifying Standard Library...");

// Math tests
print("Math module:");
try {
    print("Abs:", Math.abs(-5));
    print("Ceil:", Math.ceil(4.3));
    print("Floor:", Math.floor(4.7));
    print("Round:", Math.round(4.5));
    print("Max:", Math.max(1, 5, 3));
    print("Min:", Math.min(1, 5, 3));
    print("Pow:", Math.pow(2, 3));
    print("Sqrt:", Math.sqrt(16));
    print("Random:", Math.random());
    print("RandomInt:", Math.randomInt(1, 10));
    print("PI:", Math.PI);
    print("E:", Math.E);
    
    // Test new functions
    print("Sin(0):", Math.sin(0));
    print("Cos(0):", Math.cos(0));
    print("Tan(0):", Math.tan(0));
    print("Log(E):", Math.log(Math.E));
    print("Exp(1):", Math.exp(1));
    
} catch (e) {
    print("Math Error:", e);
}

// OS tests are removed or need std:process import
// Assuming checks below were using global OS
import Process from "std:process";
print("Process module:");
try {
    print("CWD:", Process.cwd());
    print("Args:", Process.args());
    print("Env (PATH length):", Process.env("PATH").len);  
} catch (e) {
    print("Process Error:", e);
}

print("Verification complete.");

// args: --max-instructions 100000
// test_instruction_limit.pln
import { vmStats } from "std:reflect";
fn main() {
    print("Starting infinite loop test...");
    try {
        let mut i = 0;
        while (true) {
            i = i + 1;
        }
    } catch (e) {
        print("Caught: " + e.name + ": " + e.message);
        let stats = vmStats();
        print("Peak Memory: " + stats.peakMemory.toString());
        print("Instructions: " + stats.instructions.toString());
    }
}
main();

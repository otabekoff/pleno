// args: --max-instructions 100000
// expect-error: SandboxError: instruction limit exceeded
// The instruction limit ends the program: `catch` cannot stop it, or a
// program could run on past its limit.
fn main() {
    print("Starting infinite loop test...");
    try {
        let mut i = 0;
        while (true) {
            i = i + 1;
        }
    } catch (e) {
        print("not reached: " + e.message);
    }
}
main();

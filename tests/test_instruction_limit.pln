// args: --max-instructions 100000
// test_instruction_limit.pln
fn main() {
    print("Starting infinite loop test...");
    try {
        let mut i = 0;
        while (true) {
            i = i + 1;
        }
    } catch (e) {
        print("Caught: " + e.message);
        print("Peak Memory: " + e.peakMemory.toString());
        print("Instructions: " + e.instructions.toString());
    }
}
main();

// test_memory_limit.pln
fn main() {
    print("Starting memory test...");
    let arr = [];
    try {
        for (i in 0..1000000) {
            arr.push(i);
        }
        print("Success? This should have failed.");
    } catch (e) {
        print("Caught: " + e.message);
        print("Peak Memory: " + e.peakMemory.toString());
        print("Instructions: " + e.instructions.toString());
    }
}
main();

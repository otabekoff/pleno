// test_memory_limit.pln
import { vmStats } from "std:reflect";
fn main() {
    print("Starting memory test...");
    let arr = [];
    try {
        for (i in 0..1000000) {
            arr.push(i);
        }
        print("Success? This should have failed.");
    } catch (e) {
        print("Caught: " + e.name + ": " + e.message);
        let stats = vmStats();
        print("Peak Memory: " + stats.peakMemory.toString());
        print("Instructions: " + stats.instructions.toString());
    }
}
main();

fn isEven(n) {
    return n % 2 == 0;
}

fn double(n) {
    return n * 2;
}

let result = [1, 2, 3, 4, 5] 
    |> filter(_, isEven) 
    |> map(_, double);

print("Pipeline with partials: ");
print(result);


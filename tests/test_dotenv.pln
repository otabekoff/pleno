import Dotenv from "std:dotenv";
import Process from "std:process";
import { File } from "std:io";

// Create the .env file this test loads, and remove it afterwards.
File.write(".env.test", "TEST_VAR=hello_world\n");

print("Testing Dotenv...");
Dotenv.config(".env.test");

let val = Process.env("TEST_VAR");
print("TEST_VAR:", val);

File.delete(".env.test");
if (val != "hello_world") {
    throw Error("Dotenv failed");
}

print("Dotenv passed.");

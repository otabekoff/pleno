let add = fn(x, y) => x + y;
let add5 = add(5, _);
print("add5(10) = " + add5(10));

let greet = fn(greeting, name) => greeting + ", " + name;
let hello = greet("Hello", _);
print("hello(\"World\") = " + hello("World"));


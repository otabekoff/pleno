import IO from "std:io";
const File = IO.File;

fn main() {
    print("Starting Granular IO test...");
    print("IO is: " + IO.toString());
    print("File is: " + File.toString());
    
    // Scenario 1: Access allowed file
    try {
        File.write("allowed.txt", "This is allowed");
        print("Success: Wrote to allowed.txt");
        let content = File.read("allowed.txt");
        print("Read: " + content);
        File.delete("allowed.txt");
    } catch (e) {
        print("Unexpected Error: " + e.message);
    }

    // Scenario 2: Access blocked file (read)
    try {
        print("Attempting to read blocked.txt...");
        File.read("blocked.txt");
        print("Failure: Read blocked.txt should have been denied.");
    } catch (e) {
        print("Caught (Read): " + e.message);
    }

    // Scenario 3: Access blocked file (write)
    // Scenario 4: Directory prefix test
    try {
        print("Attempting to write to /tmp/pleno_test.txt...");
        File.write("/tmp/pleno_test.txt", "granular test");
        print("Success: Wrote to /tmp/pleno_test.txt");
    } catch (e) {
        print("Caught (Dir): " + e.message);
    }
}

main();



print("Testing Rich API...");

let arr = [1, 2, 3];

// Existing
print("Testing map...");
let mapped = arr.map(fn(x) => x * 2);
print(mapped);

// Potential Missing
print("Testing flatMap...");
try {
  let flat = [[1], [2]].flatMap(fn(x) => x);
  print(flat);
} catch (e) {
  print("FlatMap missing: " + e.message);
}

print("Testing every...");
try {
  let all = [1, 2, 3].every(fn(x) => x > 0);
  print(all);
} catch (e) {
  print("Every missing: " + e.message);
}

print("Testing some...");
try {
  let any = [1, 2, 3].some(fn(x) => x > 4);
  print(any);
} catch (e) {
  print("Some missing: " + e.message);
}

print("Testing reverse...");
try {
    let rev = [1, 2, 3].reverse();
    print(rev);
} catch (e) {
    print("Reverse missing: " + e.message);
}

print("Testing sort...");
try {
    let s = [3, 1, 2].sort();
    print(s);
} catch (e) {
    print("Sort missing: " + e.message);
}

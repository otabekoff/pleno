// Test @pure annotation
@pure
fn add(a: Int, b: Int): Int {
    return a + b;
}

// Test that pure functions work
let result = add(5, 3);
print("Pure function result:", result);

// Test basic GC - create objects that should be collected
fn createObjects() {
    let arr = [];
    for i in 0..100 {
        arr.push({ value: i });
    }
    // arr goes out of scope here, should be eligible for GC
}

createObjects();
print("Objects created and should be collected");


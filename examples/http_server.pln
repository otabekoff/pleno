// skip: starts a server; covered by scripts/test_http_server.sh
import { Server, Router } from "std:http";
import { JSON } from "std:json";
import time from "std:time";

let router = Router();

router.get("/", fn(req, res) {
    res.send("Hello, Pleno!");
});

router.get("/users/:id", fn(req, res) {
    let userId = req.params.id;
    res.json({ "id": userId, "name": "User " + userId });
});

router.post("/users", fn(req, res) {
    let user = JSON.parse(req.body);
    // Save user to database
    res.status(201).json(user);
});

// Async handlers can await; the response is sent when they finish.
router.get("/delayed", async fn(req, res) {
    await time.DateTime.sleep(10);
    res.send("done after " + (req.query.ms ?? "10") + "ms");
});

let server = Server(router);
server.listen(8080, fn() {
    print("Server running on port 8080");
});

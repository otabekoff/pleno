let numbers = [10, 20, 30];
for (idx, val in numbers) {
    print("Array index " + idx + ": " + val);
}

let ages = {"Alice": 30, "Bob": 25};
for (name, age in ages) {
    print("Map key " + name + ": " + age);
}

let s = {1, 2, 3};
for (idx, val in s) {
    print("Set index " + idx + ": " + val);
}

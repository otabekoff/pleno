{
    "compilerOptions": {
        "module": "node20",
        "moduleResolution": "node16",
        "target": "es2022",
        "outDir": "out",
        "lib": [
            "es2022",
            "DOM"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        // TypeScript 6 no longer loads every @types package by default.
        "types": ["node", "mocha", "vscode"]
    },
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
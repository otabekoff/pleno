{
    "Function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2:params}) {",
            "\t$0",
            "}"
        ],
        "description": "Function"
    },
    "Function with return type": {
        "prefix": "fnr",
        "body": [
            "fn ${1:name}(${2:params}): ${3:Int} {",
            "\treturn ${0:0};",
            "}"
        ],
        "description": "Function with a return type"
    },
    "Async function": {
        "prefix": "async",
        "body": [
            "async fn ${1:name}(${2:params}) {",
            "\t$0",
            "}"
        ],
        "description": "Async function; call it with await"
    },
    "Lambda": {
        "prefix": "lambda",
        "body": [
            "fn(${1:x}) => ${0:x}"
        ],
        "description": "Anonymous function with an expression body"
    },
    "Class": {
        "prefix": "class",
        "body": [
            "class ${1:Name} {",
            "\tconstructor(${2:params}) {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Class with a constructor"
    },
    "Class extending another": {
        "prefix": "classex",
        "body": [
            "class ${1:Name} extends ${2:Base} {",
            "\tconstructor(${3:params}) {",
            "\t\tsuper(${4});",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Class that extends a base class"
    },
    "Constructor": {
        "prefix": "constructor",
        "body": [
            "constructor(${1:params}) {",
            "\t$0",
            "}"
        ],
        "description": "Class constructor"
    },
    "Property": {
        "prefix": "prop",
        "body": [
            "property ${1:name}: ${2:Int} {",
            "\tget {",
            "\t\treturn ${3:0};",
            "\t}",
            "\tset(value) {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Computed property with a getter and a setter"
    },
    "Operator overload": {
        "prefix": "op",
        "body": [
            "operator ${1|+,-,*,/,==,[]|}(${2:other}) {",
            "\t$0",
            "}"
        ],
        "description": "Operator overload inside a class"
    },
    "Interface": {
        "prefix": "interface",
        "body": [
            "interface ${1:Name} {",
            "\tfn ${2:method}(): ${3:String};",
            "}"
        ],
        "description": "Interface that classes implement"
    },
    "Enum": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name} {",
            "\t${2:First},",
            "\t${3:Second}",
            "}"
        ],
        "description": "Enum"
    },
    "Let": {
        "prefix": "let",
        "body": [
            "let ${1:name} = ${2:value};"
        ],
        "description": "Variable that cannot be reassigned"
    },
    "Let with type": {
        "prefix": "lett",
        "body": [
            "let ${1:name}: ${2:Int} = ${3:0};"
        ],
        "description": "Variable with a type annotation"
    },
    "Let mut": {
        "prefix": "letm",
        "body": [
            "let mut ${1:name} = ${2:value};"
        ],
        "description": "Variable that can be reassigned"
    },
    "Const": {
        "prefix": "const",
        "body": [
            "const ${1:NAME} = ${2:value};"
        ],
        "description": "Constant"
    },
    "If": {
        "prefix": "if",
        "body": [
            "if (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    },
    "If-else": {
        "prefix": "ife",
        "body": [
            "if (${1:condition}) {",
            "\t$2",
            "} else {",
            "\t$0",
            "}"
        ],
        "description": "If-else statement"
    },
    "For-in": {
        "prefix": "for",
        "body": [
            "for (${1:item} in ${2:items}) {",
            "\t$0",
            "}"
        ],
        "description": "Loop over the items of an array, map or range"
    },
    "For over a range": {
        "prefix": "forr",
        "body": [
            "for (${1:i} in ${2:0}..${3:10}) {",
            "\t$0",
            "}"
        ],
        "description": "Loop over a range; the end is excluded"
    },
    "While": {
        "prefix": "while",
        "body": [
            "while (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "While loop"
    },
    "Match": {
        "prefix": "match",
        "body": [
            "match (${1:value}) {",
            "\tcase ${2:pattern} => ${3:result},",
            "\tcase _ => ${0:other}",
            "}"
        ],
        "description": "Match expression"
    },
    "Import": {
        "prefix": "import",
        "body": [
            "import { ${2:name} } from \"${1:std:math}\";"
        ],
        "description": "Import names from a module (std:..., ./file.pln or a package)"
    },
    "Try-catch": {
        "prefix": "try",
        "body": [
            "try {",
            "\t$1",
            "} catch (${2:e}) {",
            "\t$0",
            "}"
        ],
        "description": "Try-catch block"
    },
    "Try-catch-finally": {
        "prefix": "tryf",
        "body": [
            "try {",
            "\t$1",
            "} catch (${2:e}) {",
            "\t$3",
            "} finally {",
            "\t$0",
            "}"
        ],
        "description": "Try-catch-finally block"
    },
    "With": {
        "prefix": "with",
        "body": [
            "with (${1:file} = ${2:File.open(\"${3:path}\")}) {",
            "\t$0",
            "}"
        ],
        "description": "With statement: closes the resource when the block ends"
    },
    "Catch by type": {
        "prefix": "catcht",
        "body": [
            "catch (${1:e}: ${2:Error}) {",
            "\t$0",
            "}"
        ],
        "description": "Catch clause that only handles one error class"
    },
    "Print": {
        "prefix": "print",
        "body": [
            "print(${1:value});"
        ],
        "description": "Print values to standard output"
    },
    "Describe": {
        "prefix": "describe",
        "body": [
            "describe(\"${1:subject}\", fn() {",
            "\ttest(\"${2:does something}\", fn() {",
            "\t\t$0",
            "\t});",
            "});"
        ],
        "description": "Group of tests (import describe and test from std:test)"
    },
    "Test": {
        "prefix": "test",
        "body": [
            "test(\"${1:does something}\", fn() {",
            "\t${0:assert.true(true);}",
            "});"
        ],
        "description": "Test case (import test and assert from std:test)"
    }
}

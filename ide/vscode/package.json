{
  "name": "pleno-language",
  "displayName": "Pleno",
  "description": "Pleno language support: highlighting, language server, debugger, test explorer and a toolchain installer.",
  "version": "0.2.0",
  "publisher": "pleno",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Testing"
  ],
  "repository": {
    "url": "https://github.com/otabekoff/pleno",
    "type": "git",
    "directory": "ide/vscode"
  },
  "homepage": "https://pleno.mohirlab.uz/guide/editor",
  "bugs": {
    "url": "https://github.com/otabekoff/pleno/issues"
  },
  "main": "out/extension.js",
  "scripts": {
    "compile": "node esbuild.js",
    "compile:tsc": "tsc -p ./",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc -watch -p ./",
    "vscode:prepublish": "npm run package",
    "package": "node esbuild.js --production",
    "pretest": "npm run compile:tsc && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "pack": "npx --yes @vscode/vsce@3.2.1 package",
    "all": "npm run pretest && npm run pack",
    "install-local": "npm run pack -- --out pleno-language.vsix && code --install-extension pleno-language.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "activationEvents": [
    "workspaceContains:**/pleno.toml",
    "onDebugResolve:pleno"
  ],
  "contributes": {
    "taskDefinitions": [
      {
        "type": "pleno",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "check"
            ],
            "description": "The pleno command to run on the file."
          },
          "file": {
            "type": "string",
            "description": "The .pln file. Defaults to the active file."
          }
        }
      },
      {
        "type": "plm",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The plm command and its arguments, for example `build --release` or `run dev`."
          }
        }
      }
    ],
    "languages": [
      {
        "id": "pleno",
        "aliases": [
          "Pleno",
          "pleno"
        ],
        "extensions": [
          ".pln"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/file-icon.svg",
          "dark": "./resources/file-icon.svg"
        }
      }
    ],
    "snippets": [
      {
        "language": "pleno",
        "path": "./snippets/pleno.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Pleno",
      "properties": {
        "pleno.cli.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `pleno` command line tool. When empty, the extension uses the toolchain it installed, then `pleno` on PATH, then `~/.pleno/bin`."
        },
        "pleno.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the language server, `pleno-lsp`. Found like `pleno.cli.path` when empty."
        },
        "pleno.dap.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the debug adapter, `pleno-dap`. Found like `pleno.cli.path` when empty; without it, debugging uses `pleno dap`."
        },
        "pleno.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report lint warnings (unused names, spacing, line length, ...) as you type. Syntax errors and `pleno check` errors are always reported."
        },
        "pleno.lint.maxLineLength": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Maximum line length for the `max-line-length` lint rule. 0 turns the rule off."
        },
        "pleno.lint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Turn individual lint rules on or off, for example `{ \"operator-spacing\": false }`. Rules are on unless set to `false`.",
          "properties": {
            "no-unused-vars": {
              "type": "boolean",
              "default": true,
              "description": "Names that are declared but never used. Prefix a name with `_` to mark it as intentionally unused."
            },
            "no-undef": {
              "type": "boolean",
              "default": true,
              "description": "Use of a name that is not declared."
            },
            "no-shadow": {
              "type": "boolean",
              "default": true,
              "description": "A variable that shadows one from an outer scope."
            },
            "operator-spacing": {
              "type": "boolean",
              "default": true,
              "description": "Missing spaces around a binary operator."
            },
            "max-line-length": {
              "type": "boolean",
              "default": true,
              "description": "Lines longer than `pleno.lint.maxLineLength`."
            },
            "no-trailing-spaces": {
              "type": "boolean",
              "default": true,
              "description": "Whitespace at the end of a line."
            },
            "semi-spacing": {
              "type": "boolean",
              "default": true,
              "description": "Missing space after a semicolon."
            }
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "pleno.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Logs the messages between VS Code and the language server to the Pleno output."
        }
      }
    },
    "commands": [
      {
        "command": "pleno.runFile",
        "title": "Run File",
        "category": "Pleno",
        "icon": "$(play)"
      },
      {
        "command": "pleno.debugFile",
        "title": "Debug File",
        "category": "Pleno",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pleno.checkFile",
        "title": "Check File",
        "category": "Pleno",
        "icon": "$(check)"
      },
      {
        "command": "pleno.runScript",
        "title": "Run Script...",
        "category": "Pleno",
        "icon": "$(play)"
      },
      {
        "command": "pleno.openRepl",
        "title": "Open REPL",
        "category": "Pleno",
        "icon": "$(terminal)"
      },
      {
        "command": "pleno.createProject",
        "title": "New Project...",
        "category": "Pleno",
        "icon": "$(new-folder)"
      },
      {
        "command": "pleno.openManifest",
        "title": "Open pleno.toml",
        "category": "Pleno",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pleno.restartServer",
        "title": "Restart Language Server",
        "category": "Pleno",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pleno.installToolchain",
        "title": "Install or Update Toolchain",
        "category": "Pleno",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pleno.uninstallToolchain",
        "title": "Uninstall Toolchain",
        "category": "Pleno",
        "icon": "$(trash)"
      },
      {
        "command": "pleno.showStatus",
        "title": "Show Status",
        "category": "Pleno",
        "icon": "$(info)"
      },
      {
        "command": "pleno.openDocs",
        "title": "Open Documentation",
        "category": "Pleno",
        "icon": "$(book)"
      },
      {
        "command": "pleno.openWalkthrough",
        "title": "Open Walkthrough",
        "category": "Pleno",
        "icon": "$(compass)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pleno.runFile",
          "when": "resourceLangId == pleno",
          "group": "navigation@1"
        },
        {
          "command": "pleno.debugFile",
          "when": "resourceLangId == pleno",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "pleno.runFile",
          "when": "resourceLangId == pleno",
          "group": "pleno@1"
        },
        {
          "command": "pleno.debugFile",
          "when": "resourceLangId == pleno",
          "group": "pleno@2"
        },
        {
          "command": "pleno.checkFile",
          "when": "resourceLangId == pleno",
          "group": "pleno@3"
        }
      ],
      "explorer/context": [
        {
          "command": "pleno.runFile",
          "when": "resourceExtname == .pln",
          "group": "pleno@1"
        },
        {
          "command": "pleno.checkFile",
          "when": "resourceExtname == .pln",
          "group": "pleno@2"
        }
      ],
      "view/title": [
        {
          "command": "pleno.openManifest",
          "when": "view == plenoProject",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pleno.runScript",
          "when": "view == plenoProject && viewItem == script",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "pleno.runFile",
          "when": "editorLangId == pleno"
        },
        {
          "command": "pleno.debugFile",
          "when": "editorLangId == pleno"
        },
        {
          "command": "pleno.checkFile",
          "when": "editorLangId == pleno"
        },
        {
          "command": "pleno.runScript",
          "when": "pleno.hasProject"
        },
        {
          "command": "pleno.openManifest",
          "when": "pleno.hasProject"
        },
        {
          "command": "pleno.uninstallToolchain",
          "when": "pleno.toolchainInstalled"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "pleno-welcome",
        "title": "Get Started with Pleno",
        "description": "Install the toolchain, create a project, and run, debug and test Pleno code.",
        "steps": [
          {
            "id": "toolchain",
            "title": "Install the toolchain",
            "description": "The extension needs the Pleno tools: `pleno`, `plm`, the language server and the debugger. This step is done when they are found.\n[Install Toolchain](command:pleno.installToolchain)",
            "media": {
              "markdown": "resources/walkthrough/toolchain.md"
            },
            "completionEvents": [
              "onContext:pleno.toolchainFound"
            ]
          },
          {
            "id": "project",
            "title": "Create a project",
            "description": "`plm init` writes `pleno.toml`, `src/main.pln` and a test. Run it in an empty folder.\n[New Project](command:pleno.createProject)",
            "media": {
              "markdown": "resources/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:pleno.hasProject"
            ]
          },
          {
            "id": "run",
            "title": "Run and debug",
            "description": "Run the open file, or set a breakpoint and debug it with F5.\n[Run File](command:pleno.runFile)",
            "media": {
              "markdown": "resources/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:pleno.runFile",
              "onCommand:pleno.debugFile"
            ]
          },
          {
            "id": "test",
            "title": "Write tests",
            "description": "Tests written with `std:test` show up in the Testing view.\n[Open Testing View](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "resources/walkthrough/test.md"
            },
            "completionEvents": [
              "onCommand:workbench.view.testing.focus"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the language",
            "description": "The tutorial and guide cover the syntax, the standard library and packages.\n[Open Documentation](command:pleno.openDocs)",
            "media": {
              "markdown": "resources/walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:pleno.openDocs"
            ]
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "pleno",
        "scopeName": "source.pleno",
        "path": "./syntaxes/pleno.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pleno.codeblock",
        "path": "./syntaxes/pleno.markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pleno": "pleno"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "plenoProject",
          "name": "Pleno Project",
          "when": "pleno.hasProject",
          "icon": "resources/file-icon.svg",
          "contextualTitle": "Pleno"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "pleno"
      }
    ],
    "debuggers": [
      {
        "type": "pleno",
        "label": "Pleno",
        "languages": [
          "pleno"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .pln file to debug.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program. Defaults to the workspace folder.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the program.",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pleno",
            "request": "launch",
            "name": "Debug current file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Pleno: Launch",
            "description": "Debug a Pleno file",
            "body": {
              "type": "pleno",
              "request": "launch",
              "name": "Debug ${1:src/main.pln}",
              "program": "^\"\\${workspaceFolder}/${1:src/main.pln}\""
            }
          }
        ]
      }
    ],
    "tomlValidation": [
      {
        "fileMatch": "pleno.toml",
        "url": "./schemas/pleno.toml.schema.json"
      }
    ]
  },
  "dependencies": {
    "smol-toml": "^1.6.0",
    "vscode-languageclient": "^9.0.1"
  },
  "license": "MIT",
  "keywords": [
    "pleno",
    "pln",
    "plm",
    "language server",
    "debugger"
  ]
}

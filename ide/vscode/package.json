{
  "name": "pleno-language",
  "displayName": "Pleno Language Support",
  "description": "Pleno Programming Language Support Extension for VSCode with Syntax highlighting for Pleno (.pln)",
  "version": "0.1.0",
  "publisher": "pleno",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "url": "https://github.com/otabekoff/pleno",
    "type": "git",
    "directory": "ide/vscode"
  },
  "homepage": "https://github.com/otabekoff/pleno#readme",
  "bugs": {
    "url": "https://github.com/otabekoff/pleno/issues"
  },
  "main": "out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "pack": "vsce package && antigravity --install-extension pleno-language-0.1.0.vsix",
    "all": "npm run pretest && npm run pack"
  },
  "devDependencies": {
    "@types/node": "25.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "activationEvents": [
    "onCommand:markdown.showPreview",
    "onCommand:markdown.showPreviewToSide",
    "workspaceContains:**/*.pln"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pleno",
        "aliases": [
          "Pleno",
          "pleno"
        ],
        "extensions": [
          ".pln"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "pleno",
        "label": "Pleno",
        "path": "./resources/file-icons.json"
      }
    ],
    "snippets": [
      {
        "language": "pleno",
        "path": "./snippets/pleno.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Pleno",
      "properties": {
        "pleno.lsp.path": {
          "type": "string",
          "default": "pleno-lsp",
          "description": "Path to the Pleno Language Server executable."
        },
        "pleno.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Pleno Language Server."
        }
      }
    },
    "commands": [
      {
        "command": "pleno.runFile",
        "title": "Pleno: Run Current File",
        "category": "Pleno"
      },
      {
        "command": "pleno.checkFile",
        "title": "Pleno: Check Current File",
        "category": "Pleno"
      },
      {
        "command": "pleno.restartServer",
        "title": "Pleno: Restart Language Server",
        "category": "Pleno"
      }
    ],
    "grammars": [
      {
        "language": "pleno",
        "scopeName": "source.pleno",
        "path": "./syntaxes/pleno.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pleno.codeblock",
        "path": "./syntaxes/pleno.markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
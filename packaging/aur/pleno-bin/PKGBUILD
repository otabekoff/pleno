# Maintainer: Otabek Sadiridinov <sadiridinovotabek@gmail.com>
pkgname=pleno-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="A readable programming language with optional checked types and async built in (prebuilt binaries)"
arch=('x86_64' 'aarch64')
url="https://pleno.mohirlab.uz/"
license=('MIT')
depends=('gcc-libs' 'glibc')
provides=('pleno')
conflicts=('pleno')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/otabekoff/pleno/v$pkgver/LICENSE")
source_x86_64=("pleno-v$pkgver-x86_64.tar.gz::https://github.com/otabekoff/pleno/releases/download/v$pkgver/pleno-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("pleno-v$pkgver-aarch64.tar.gz::https://github.com/otabekoff/pleno/releases/download/v$pkgver/pleno-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums=('8c254b459213d3850ee5ef4a8a8701dcadb5b5e6e7fa39dc5a148397f534a0c9')
sha256sums_x86_64=('8d769b1f55b99adbb4c8234c25779a110a588c2d59ab94142936fda88a436b32')
sha256sums_aarch64=('018f93f3127becc48785f4e90e56d73d5de93a6f670efe8cb45c0c74489f0d4f')

package() {
    for tool in pleno plm pleno-lsp pleno-dap pleno-repl; do
        install -Dm755 "$tool" "$pkgdir/usr/bin/$tool"
    done
    install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# Maintainer: Otabek Ismoilov <your-email@example.com>
pkgname=pleno
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern programming language with clarity, safety, and expressiveness"
arch=('x86_64' 'aarch64')
url="https://pleno.mohirlab.uz/"
license=('MIT')
depends=('openssl')
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/otabekoff/pleno/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --workspace
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --workspace
}

package() {
    cd "$pkgname-$pkgver"
    
    # Install binaries
    install -Dm755 "target/release/pleno" "$pkgdir/usr/bin/pleno"
    install -Dm755 "target/release/plm" "$pkgdir/usr/bin/plm"
    
    # Install license
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    
    # Install documentation
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

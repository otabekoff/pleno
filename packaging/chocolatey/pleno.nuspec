<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>pleno</id>
    <version>0.3.0</version>
    <title>Pleno Programming Language</title>
    <authors>Otabek Ismoilov</authors>
    <owners>otabekoff</owners>
    <licenseUrl>https://github.com/otabekoff/pleno/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://pleno.mohirlab.uz/</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/otabekoff/pleno/main/docs/public/logo.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Pleno is a dynamically typed programming language with optional type annotations that are checked when the program runs, classes and pattern matching, and async built in. This package installs pleno (compiler and runtime), plm (package manager), pleno-lsp (language server), pleno-dap (debug adapter) and pleno-repl.</description>
    <summary>A readable programming language with optional checked types and async built in</summary>
    <releaseNotes>https://github.com/otabekoff/pleno/releases/tag/v0.3.0</releaseNotes>
    <copyright>Copyright 2026 Otabek Ismoilov and Pleno contributors</copyright>
    <tags>pleno programming language compiler interpreter</tags>
    <packageSourceUrl>https://github.com/otabekoff/pleno/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://pleno.mohirlab.uz/</docsUrl>
    <bugTrackerUrl>https://github.com/otabekoff/pleno/issues</bugTrackerUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

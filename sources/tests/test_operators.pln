// Operator Overloading Verification Test
print("Testing Operator Overloading...");

class Vector {
    private x;
    private y;
    
    constructor(x, y) {
        this.x = x;
        this.y = y;
    }
    
    fn getX() {
        return this.x;
    }
    
    fn getY() {
        return this.y;
    }
    
    operator +(other) {
        return Vector(this.x + other.getX(), this.y + other.getY());
    }
    
    operator *(scalar) {
        return Vector(this.x * scalar, this.y * scalar);
    }
}

// Test + operator
let v1 = Vector(1.0, 2.0);
let v2 = Vector(3.0, 4.0);
let v3 = v1 + v2;

print("v1 = (" + v1.getX() + ", " + v1.getY() + ")");
print("v2 = (" + v2.getX() + ", " + v2.getY() + ")");
print("v3 = v1 + v2 = (" + v3.getX() + ", " + v3.getY() + ")");

if (v3.getX() == 4.0 && v3.getY() == 6.0) {
    print("SUCCESS: + operator overload works");
} else {
    print("FAILURE: + operator overload failed");
}

// Test * operator
let v4 = v1 * 2.0;
print("v4 = v1 * 2.0 = (" + v4.getX() + ", " + v4.getY() + ")");

if (v4.getX() == 2.0 && v4.getY() == 4.0) {
    print("SUCCESS: * operator overload works");
} else {
    print("FAILURE: * operator overload failed");
}

print("Operator Overloading verification completed!");

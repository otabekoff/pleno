// Test if array out-of-bounds errors are catchable
fn test_out_of_bounds() {
    let arr = [1, 2, 3];
    try {
        let x = arr[10];
        print("ERROR: should not reach here!");
    } catch (e) {
        print("SUCCESS: Caught out-of-bounds error:", e.message);
    }
}

test_out_of_bounds();

import { Math } from "std:math";

print("Testing std:math");

print("Math.abs(-10):", Math.abs(-10));
if (Math.abs(-10) != 10) throw "Math.abs failed";

print("Math.min(5, 10):", Math.min(5, 10));
if (Math.min(5, 10) != 5.0) throw "Math.min failed";

print("Math.max(5, 10):", Math.max(5, 10));
if (Math.max(5, 10) != 10.0) throw "Math.max failed";

print("Math.floor(3.7):", Math.floor(3.7));
if (Math.floor(3.7) != 3) throw "Math.floor failed";

print("Math.ceil(3.2):", Math.ceil(3.2));
if (Math.ceil(3.2) != 4) throw "Math.ceil failed";

print("Math.sqrt(16):", Math.sqrt(16));
if (Math.sqrt(16) != 4.0) throw "Math.sqrt failed";

print("std:math: PASSED");

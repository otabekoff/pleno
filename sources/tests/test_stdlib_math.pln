// Test: Math Standard Library
 
import math from "std:math";
 
print("PI: " + math.Math.PI);
print("E: " + math.Math.E);
print("abs(-42): " + math.Math.abs(-42));
print("floor(3.7): " + math.Math.floor(3.7));
print("ceil(3.2): " + math.Math.ceil(3.2));
print("round(3.5): " + math.Math.round(3.5));
print("pow(2, 10): " + math.Math.pow(2, 10));
print("sqrt(144): " + math.Math.sqrt(144));
print("sin(0): " + math.Math.sin(0));
print("cos(0): " + math.Math.cos(0));
print("min(5, 3, 8): " + math.Math.min(5, 3, 8));
print("max(5, 3, 8): " + math.Math.max(5, 3, 8));
 
if (math.Math.abs(-42) == 42 && math.Math.sqrt(144) == 12) {
    print("SUCCESS: Math stdlib works");
}

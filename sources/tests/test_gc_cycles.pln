// GC Cycle Reclamation Test
 
import _gc from "std:gc";

class Node {
    constructor(name) {
        this.name = name;
        this.next = null;
    }
}
 
fn create_cycle() {
    let a = Node("A");
    let b = Node("B");
    a.next = b;
    b.next = a; // Cycle
    print("Cycle created");
}
 
print("Testing GC Cycle Reclamation...");
let initial = { heap_size: _gc.heapSize() };
print("Initial heap size: " + initial.heap_size);
 
create_cycle();
let after_create = { heap_size: _gc.heapSize() };
print("Heap size after creation: " + after_create.heap_size);
 
_gc.collect();
let after_collect = { heap_size: _gc.heapSize() };
print("Heap size after manual collect (should not change yet): " + after_collect.heap_size);
 
// Now the local variables from create_cycle are gone, so the cycle should be reclaimed
_gc.collect();
let final = { heap_size: _gc.heapSize() };
print("Final heap size: " + final.heap_size);
 
if (final.heap_size < after_create.heap_size) {
    print("SUCCESS: Cyclic references reclaimed!");
} else {
    print("FAILURE: Heap size did not decrease. Final: " + final.heap_size + ", After create: " + after_create.heap_size);
    // Note: This might fail if the VM/Compiler creates other objects in between.
    // But basic cyclic objects should be gone.
}

// Test Interface Satisfaction Validation

interface ILogger {
    fn log(message);
    fn info(message);
}

interface ISerializable {
    fn serialize() : string;
}

print("Testing Interface Validation...");

// Case 1: Correct Implementation
class FileLogger implements ILogger {
    fn log(msg) { print("LOG:", msg); }
    fn info(msg) { print("INFO:", msg); }
}

print("SUCCESS: FileLogger correctly implements ILogger");

// Case 2: Missing Method
try {
    class IncompleteLogger implements ILogger {
        fn log(msg) { print("LOG:", msg); }
    }
    print("FAILED: IncompleteLogger should have thrown an error");
} catch (e) {
    print("SUCCESS: Caught missing method error:", e.message);
}

// Case 3: Arity Mismatch
try {
    class BadArityLogger implements ILogger {
        fn log(msg) { print("LOG:", msg); }
        fn info(msg, level) { print(level, ":", msg); }
    }
    print("FAILED: BadArityLogger should have thrown an error");
} catch (e) {
    print("SUCCESS: Caught arity mismatch error:", e.message);
}

// Case 4: Multiple Interfaces
class AdvancedLogger implements ILogger, ISerializable {
    fn log(msg) { print("LOG:", msg); }
    fn info(msg) { print("INFO:", msg); }
    fn serialize() { return "AdvancedLoggerData"; }
}

print("SUCCESS: AdvancedLogger implements multiple interfaces");

print("Interface Validation Test Completed");

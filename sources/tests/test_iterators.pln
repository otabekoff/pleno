// test_iterators.pln

print("--- Array Iteration ---");
let arr = [1, 2, 3];
for (x in arr) {
    print(x);
}

print("--- Array Entries Iteration ---");
for (i, x in arr) {
    print(i + ": " + x);
}

print("--- Map Iteration (Keys) ---");
let m = {"a": 1, "b": 2};
for (k in m) {
    print(k);
}

print("--- Map Entries Iteration ---");
for (k, v in m) {
    print(k + " => " + v);
}

print("--- Set Iteration ---");
let s = new Set();
s.add(10);
s.add(20);
for (x in s) {
    print(x);
}

print("--- Range Iteration ---");
for (i in 1..5) {
    print(i);
}

print("--- Custom Object Iterator ---");
class Counter {
    _start;
    _end;
    
    constructor(start, end) {
        this._start = start;
        this._end = end;
    }
    
    fn iterator() {
        return CounterIterator(this._start, this._end);
    }
}

class CounterIterator {
    _current;
    _end;
    
    constructor(current, end) {
        this._current = current;
        this._end = end;
    }
    
    fn next() {
        if (this._current <= this._end) {
            let val = this._current;
            this._current = this._current + 1;
            return val;
        }
        return stopIteration();
    }
}

print("--- Custom Counter ---");
let c = Counter(1, 3);
for (x in c) {
    print(x);
}

// Test file for advanced pattern matching

fn test_guards(x) {
    print("Testing guards for " + x);
    match (x) {
        case n if n < 10 => print("Single digit: " + n),
        case n if n < 100 => print("Double digit: " + n),
        case _ => print("Large number")
    }
}

fn test_types(x) {
    print("Testing types for " + x);
    match (x) {
        case Int i => print("Integer: " + i),
        case String s => print("String: " + s),
        case _ => print("Unknown type")
    }
}

fn test_multi(x) {
    print("Testing multi-patterns for " + x);
    match (x) {
        case 1, 2, 3 => print("1, 2, or 3"),
        case 10, 20 => print("10 or 20"),
        case _ => print("Something else")
    }
}

fn test_objects(x) {
    print("Testing objects for " + x);
    match (x) {
        case { x: 1, y: 2 } => print("Point(1, 2)"),
        case { x, y: 0 } => print("On X axis at " + x),
        case _ => print("Other object")
    }
}

fn test_variants(x) {
    print("Testing variants for " + x);
    match (x) {
        case Some(v) => print("Got some: " + v),
        case None() => print("Got none"),
        case _ => print("Not an option")
    }
}

test_guards(5);
test_guards(50);
test_guards(500);

test_types(42);
test_types("hello");
test_types(true);

test_multi(2);
test_multi(20);
test_multi(5);

test_objects({ "x": 1, "y": 2 });
test_objects({ "x": 10, "y": 0 });
test_objects({ "x": 5, "y": 5 });

// Mock Option type
let someValue = { "variant": "Some", "value": "world" };
let noneValue = { "variant": "None", "value": null };

test_variants(someValue);
test_variants(noneValue);
test_variants(42);

// Test: Mixed Multi-Patterns and Rest
 
let list = [1, 2, 3, 4, 5, 6];
 
fn verify_rest(rest) {
    print("Matched 1, 2. Rest length: " + rest.length);
    if (rest.length == 4) {
        print("SUCCESS: Rest pattern length OK");
    }
}
 
// Use simple value test instead of array pattern destructuring
print("Testing rest pattern with simple check:");
if (list[0] == 1 && list[1] == 2) {
    let rest = [list[2], list[3], list[4], list[5]];
    verify_rest(rest);
}
 
match 2 {
    case 1, 2, 3 => print("SUCCESS: Or pattern works (1, 2, 3) matched 2"),
    case _ => print("FAILURE")
}

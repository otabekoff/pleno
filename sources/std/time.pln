// Time standard library module
// Date and Time manipulation

import _time from "std:time";

export class DateTime {
    private timestamp: Int;

    constructor(timestamp: Int) {
        this.timestamp = timestamp;
    }

    public static fn now(): DateTime {
        let native = _time.DateTime.now();
        return DateTime(native._timestamp);
    }
 
    public static fn now_ns(): Int {
        return _time.now_ns();
    }
 
    public static fn sleep(ms: Int) {
        return _time.sleep(ms);
    }

    public static fn parse(dateStr: String, fmt: String): DateTime {
        return DateTime(_time.parse(dateStr, fmt));
    }

    public fn format(fmt: String): String {
        return _time.format(this.timestamp, fmt);
    }

    public fn add(duration: Duration): DateTime {
        return DateTime(this.timestamp + duration.getSeconds());
    }

    public fn subtract(duration: Duration): DateTime {
        return DateTime(this.timestamp - duration.getSeconds());
    }

    public fn getTimestamp(): Int {
        return this.timestamp;
    }
}

export class Duration {
    private seconds: Int;

    constructor(seconds: Int) {
        this.seconds = seconds;
    }

    public static fn seconds(s: Int): Duration {
        return Duration(s);
    }

    public static fn minutes(m: Int): Duration {
        return Duration(m * 60);
    }

    public static fn hours(h: Int): Duration {
        return Duration(h * 3600);
    }

    public static fn days(d: Int): Duration {
        return Duration(d * 86400);
    }

    public fn getSeconds(): Int {
        return this.seconds;
    }
}

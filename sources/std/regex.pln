// Regex standard library module
// Regular expression operations

import _regex from "std:regex";

export class Match {
    private groups: Array;

    constructor(groups: Array) {
        this.groups = groups;
    }

    public fn group(index: Int): String {
        if (index < 0 || index >= this.groups.length) {
            return null;
        }
        return this.groups[index];
    }

    public fn length(): Int {
        return this.groups.length;
    }
}

export class Regex {
    private native: Any;

    constructor(pattern: String) {
        this.native = _regex.Regex(pattern);
    }

    public fn test(text: String): Bool {
        return this.native.test(text);
    }

    public fn match(text: String): Match {
        let groups = this.native.match(text);
        if (groups == null) {
            return null;
        }
        return Match(groups);
    }

    public fn replace(text: String, replacement: String): String {
        return this.native.replace(text, replacement);
    }

    public fn findAll(text: String): Array {
        let rawMatches = this.native.findAll(text);
        if (rawMatches == null) {
            return [];
        }
        let matches = [];
        for (groups in rawMatches) {
            matches.push(Match(groups));
        }
        return matches;
    }

    public static fn isMatch(pattern: String, text: String): Bool {
        return _regex.Regex(pattern).test(text);
    }

    public static fn replace(pattern: String, text: String, replacement: String): String {
        return _regex.Regex(pattern).replace(text, replacement);
    }
}


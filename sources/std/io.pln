// I/O standard library module
// File and directory operations

import _io from "std:io";

export class File {
    public static fn read(path: String): String {
        return _io.File.read(path);
    }

    public static fn write(path: String, content: String): Void {
        return _io.File.write(path, content);
    }
}

export class Directory {
    public static fn list_files(path: String): Array {
        return _io.Directory.list_files(path);
    }

    public static fn list_directories(path: String): Array {
        return _io.Directory.list_directories(path);
    }

    public static fn createRecursive(path: String): Void {
        return _io.Directory.createRecursive(path);
    }

    public static fn deleteRecursive(path: String): Void {
        return _io.Directory.deleteRecursive(path);
    }
}

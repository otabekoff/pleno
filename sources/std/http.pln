// HTTP standard library module
// HTTP client operations

import _http from "std:http";

export class Http {
    public static fn get(url) {
        return _http.HTTP.get(url);
    }

    public static fn post(url, body) {
        return _http.HTTP.post(url, body);
    }

    public static fn put(url, body) {
        return _http.HTTP.put(url, body);
    }

    public static fn delete(url) {
        return _http.HTTP.delete(url);
    }
}

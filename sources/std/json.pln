// JSON standard library module
// JSON parsing and stringification

import _json from "std:json";

export class JSON {
    public static fn parse(json: String): Any {
        return _json.JSON.parse(json);
    }

    public static fn stringify(value: Any): String {
        return _json.JSON.stringify(value);
    }

    public static fn stringifyPretty(value: Any, indent: Int = 2): String {
        //indent argument is not used in native stringify yet, but we'll keep it for future use.
        return _json.JSON.stringify(value);
    }
}

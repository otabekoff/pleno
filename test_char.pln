import Reflect from "std:reflect";
import Process from "std:process";

fn assert(cond, msg) {
    if !cond {
        print("ASSERTION FAILED: " + msg);
        Process.exit(1);
    }
}

// 1. Literals
let c = 'A';
print("Char value: ");
print(c);
let typeName = Reflect.getTypeName(c);
print("Type name: ");
print(typeName);
assert(typeName == "Char", "type('A') should be 'Char'");

// 2. Concatenation
let s1 = "Hello " + 'W';
print("Concat String + Char: ");
print(s1);
assert(s1 == "Hello W", "Concat Hello + W failed");

let s2 = '!' + " Wow";
print("Concat Char + String: ");
print(s2);
assert(s2 == "! Wow", "Concat ! + Wow failed");

let s3 = 'A' + 'B';
print("Concat Char + Char: ");
print(s3);
assert(s3 == "AB", "Concat A + B failed");

// 3. Sets
let charSet = {'A', 'B', 'A'};
print("Set with chars: ");
print(charSet);
assert(charSet.contains('A'), "Set should have 'A'");
assert(charSet.contains('B'), "Set should have 'B'");
assert(!charSet.contains('C'), "Set should not have 'C'");

// 4. Comparison
assert('A' == 'A', "A == A failed");
assert('A' != 'B', "A != B failed");
assert('A' != "A", "A != 'A' (string) failed");

print("ALL CHAR TESTS PASSED!");

// Test Promise.all and race
print("Testing Promise.all and race...");

async fn delay(ms: Int, val: Int): Promise<Int> {
    return val;
}

async fn run() {
    print("Starting Promise.all test");
    let p1 = delay(100, 1);
    let p2 = delay(200, 2);
    let all = await Promise.all([p1, p2]);
    print("Promise.all result: " + all);

    print("Starting Promise.race test");
    let r1 = delay(100, 10);
    let r2 = delay(200, 20);
    let race = await Promise.race([r1, r2]);
    print("Promise.race result: " + race);
}

run();
print("Done.");

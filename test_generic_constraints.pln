interface Comparable {
    fn compareTo(other: Any): Int;
}

class Box<T: Comparable> {
    value: T;
    constructor(value: T) {
        this.value = value;
    }
}

class Person {
    name: String;
    constructor(name: String) {
        this.name = name;
    }
}

println("Testing generic constraints...");

try {
    let b1 = Box<Int>(10);
    println("Box<Int> created successfully");
} catch (e) {
    println("Error creating Box<Int>: " + e.toString());
}

try {
    let b2 = Box<Person>(Person("Alice"));
    println("Box<Person> created successfully (SHOULD HAVE FAILED)");
} catch (e) {
    println("Caught expected error for Box<Person>: " + e.toString());
}
